{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constraint-exec.local/schemas/generation-response.schema.json",
  "title": "Constraint Exec Generation Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "operation"],
  "properties": {
    "protocol_version": {"const": "constraint-exec-generation/v1"},
    "operation": {"enum": ["generate", "capabilities", "error"]},
    "executors": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/executorDescriptor"}
    },
    "sandboxes": {"type": "array", "uniqueItems": true, "items": {"enum": ["read-only", "workspace-write"]}},
    "result": {"$ref": "#/$defs/generationResult"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"operation": {"const": "generate"}}}, "then": {"required": ["result"]}},
    {"if": {"properties": {"operation": {"const": "capabilities"}}}, "then": {"required": ["executors", "sandboxes"]}},
    {"if": {"properties": {"operation": {"const": "error"}}}, "then": {"required": ["error"]}}
  ],
  "$defs": {
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structured_output", "workspace_access", "reasoning_effort", "usage_reporting", "local_execution"],
      "properties": {
        "structured_output": {"type": "boolean"},
        "workspace_access": {"type": "boolean"},
        "reasoning_effort": {"type": "boolean"},
        "usage_reporting": {"type": "boolean"},
        "local_execution": {"type": "boolean"}
      }
    },
    "executorDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "capabilities"],
      "properties": {
        "name": {"type": "string"},
        "default_model": {"type": "string"},
        "capabilities": {"$ref": "#/$defs/capabilities"}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cached_input_tokens", "reasoning_tokens", "total_tokens", "raw"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "raw": {"type": "object"}
      }
    },
    "generationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor", "model", "success", "output", "stderr", "returncode", "duration_seconds", "usage", "failure_kind", "failure_message", "capabilities", "trace_path", "output_path", "metadata"],
      "properties": {
        "executor": {"type": "string"},
        "model": {"type": "string"},
        "success": {"type": "boolean"},
        "output": {"type": "string"},
        "stderr": {"type": "string"},
        "returncode": {"type": ["integer", "null"]},
        "duration_seconds": {"type": "number", "minimum": 0},
        "usage": {"$ref": "#/$defs/usage"},
        "failure_kind": {"enum": ["none", "timeout", "rate_limit", "authentication", "network", "model_not_found", "context_limit", "executable_missing", "invalid_request", "cancelled", "process_error", "output_error", "empty_output", "unknown"]},
        "failure_message": {"type": ["string", "null"]},
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "trace_path": {"type": ["string", "null"]},
        "output_path": {"type": ["string", "null"]},
        "metadata": {"type": "object"}
      }
    }
  }
}
