        "objective": "Design a secure file-upload API system with durable storage, metadata management, download capabilities, audit logging, and comprehensive testing.",
        "requirements": [
          {
            "id": "REQ-001",
            "statement": "API must support file uploads to durable storage systems (e.g., S3 compatible), including retention of original content if permitted by security rules.",
            "acceptance_criteria": [
              "Files are persisted in an object store with unique, immutable keys upon successful upload.",
              "Metadata is stored independently from the binary blob and includes timestamp, uploader ID, filename, size (bytes), MIME type declaration."
            ]
          },
          {
            "id": "REQ-002",
            "statement": "API must provide a mechanism to retrieve/download previously uploaded files.",
            "acceptance_criteria": [
              "A public or authenticated endpoint returns the file stream associated with a specific resource ID.",
              "HTTP status 404 is returned if no matching record exists for the provided identifier."
            ]
          },
          {
            "id": "REQ-003",
            "statement": "API must maintain an immutable audit log of all upload and download attempts (successes and failures).",
            "acceptance_criteria": [
              "Every request receives a corresponding entry in the audit stream containing timestamp, user agent, IP address, operation type, status code.",
              "Audit entries are stored with integrity controls preventing tampering or deletion."
            ]
          },
          {
            "id": "REQ-004",
            "statement": "System must automatically generate and execute test cases validating all functional behaviors defined in REQ-001 through REQ-003.",
            "acceptance_criteria": [
              "Test suite exists within the repository covering edge cases for file size, metadata corruption simulation, missing permissions."
            ]
          },
          {
            "id": "REQ-005",
            "statement": "API must reject uploads containing executable content even if submitted via a misleading extension (e.g., .txt wrapping PowerShell script) or an incorrect MIME type.",
            "acceptance_criteria": [
              "Upload endpoint returns HTTP 422/403 for any file failing the static analysis heuristic check regardless of provided filename."
            ]
          }
        ],
